# Dependencies
node_modules/
.pnp
.pnp.js

# Build outputs
.next/
# Side-by-side builds from design/QA experiments — .next-brand-A, .next-v2,
# .next-3004 and friends. Untracked but not ignored, they were sixteen
# directories deep enough to make `git add -A` stage a few thousand build
# artefacts by accident.
.next-*/
out/
dist/
build/

# Credential files kept locally for reference. These are untracked but were not
# ignored, which is only ever one careless `git add -A` away from a public repo
# holding a live OAuth secret.
*ClientID-Secret*
*client_secret*.json
*credentials*.json

# Environment files
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
.env.production

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
*.log

# OS
.DS_Store
Thumbs.db

# Editor
.vscode/
.idea/
*.swp
*.swo

# TypeScript
*.tsbuildinfo

# MinIO / uploads (local dev)
uploads/
minio-data/

# PM2
.pm2/

# Misc
.vercel
coverage/

# SDK build output — published from CI, not committed.
packages/sdk/dist/

# Raw test-runner output. The aggregated report (frontend/lib/qa-report.generated.json)
# IS committed — it's what the owner dashboard renders.
frontend/tests/.reports/
frontend/tests/.fixtures/

# MCP Registry signing key — proves we own diemdesk.com to the registry.
# NEVER commit this: anyone holding it can publish servers under our name.
mcp/mcp-registry-key.pem
*.pem

# Font binaries pulled apart by the dev-harness while debugging Edit PDF's
# embedded fonts. They are extraction OUTPUT, not source — ~1 MB that the
# harness regenerates on demand, so committing them only makes clones heavier.
dev-harness/carlito.ttf
dev-harness/extract-F*-ttf

# Session handover notes. They carry the production IP and ssh invocations,
# so they live in the PRIVATE memory repo (DailyDesk-Memory), not here.
SESSION-HANDOFF*.md
SESSION-SUMMARY*.md
