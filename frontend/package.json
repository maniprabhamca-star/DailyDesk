{
  "name": "dailydesk-frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "og": "node scripts/gen-og-images.mjs",
    "prebuild": "node scripts/gen-sw.mjs",
    "predev": "node scripts/gen-sw.mjs",
    "sw": "node scripts/gen-sw.mjs",
    "test:sw": "node scripts/gen-sw.mjs && node scripts/test-sw.mjs",
    "test:unit": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test --project=chromium",
    "test:e2e:all": "playwright test --project=chromium --project=firefox --project=webkit --project=mobile",
    "test:e2e:ui": "playwright test --ui",
    "test:throttle": "playwright test tests/e2e/throttle.spec.ts --project=chromium-slow",
    "test:perf": "lhci autorun --config=tests/perf/lighthouserc.json",
    "test:all": "npm run test:unit && npm run test:sw && npm run build && npm run test:e2e",
    "qa:bench": "node ../scripts/qa-bench.mjs",
    "qa:report": "node ../scripts/qa-report.mjs",
    "qa:all": "npm run qa:e2e:json && npm run qa:unit:json && npm run qa:bench && npm run qa:report",
    "qa:e2e:json": "playwright test --project=chromium --reporter=json > tests/.reports/e2e-chromium.json",
    "qa:unit:json": "vitest run --pool=forks --reporter=json --outputFile=tests/.reports/unit.json",
    "postbuild": "node scripts/gen-llms.mjs",
    "llms": "node scripts/gen-llms.mjs",
    "audit:gate": "node scripts/audit-gate.mjs"
  },
  "dependencies": {
    "@jsquash/jpeg": "^1.6.0",
    "@neslinesli93/qpdf-wasm": "^0.3.0",
    "@pdf-lib/fontkit": "^1.1.1",
    "@radix-ui/react-dialog": "^1.1.2",
    "@radix-ui/react-dropdown-menu": "^2.1.2",
    "@radix-ui/react-slot": "^1.1.0",
    "@radix-ui/react-toast": "^1.2.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "framer-motion": "^11.18.2",
    "gifenc": "^1.0.3",
    "hash-wasm": "^4.12.0",
    "jsqr": "^1.4.0",
    "jszip": "^3.10.1",
    "libheif-js": "^1.19.8",
    "lucide-react": "^0.446.0",
    "mp4-muxer": "^5.2.2",
    "next": "^15.5.21",
    "next-themes": "^0.4.6",
    "onnxruntime-web": "^1.27.0",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.1.200",
    "qrcode": "^1.5.4",
    "react": "^18",
    "react-dom": "^18",
    "tailwind-merge": "^2.5.4",
    "webm-muxer": "^5.1.4"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@playwright/test": "^1.62.0",
    "@types/node": "^20",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "@vitest/coverage-v8": "^4.1.10",
    "autoprefixer": "^10.0.1",
    "eslint": "^8",
    "eslint-config-next": "14.2.20",
    "jsdom": "^30.0.1",
    "lamejs": "^1.2.1",
    "postcss": "^8",
    "tailwindcss": "^3.4.1",
    "typescript": "^5",
    "vitest": "^4.1.10"
  }
}
